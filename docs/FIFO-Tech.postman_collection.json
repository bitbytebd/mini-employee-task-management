{
  "info": {
    "name": "FIFO Tech Employee and Task Management",
    "description": "Use Login first; the test script stores the JWT in collection variable token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" },
    { "key": "token", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "taskId", "value": "" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "pm.collectionVariables.set('token', body.token);"] }}],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@fifo.local\",\n  \"password\": \"<local-demo-password>\"\n}" }, "url": "{{baseUrl}}/auth/login" }
        }
      ]
    },
    {
      "name": "Users (Admin)",
      "item": [
        { "name": "List users", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/users?page=0&size=10&search=" } },
        { "name": "Current user", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/users/me" } },
        { "name": "Manager team", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/users/team" } },
        { "name": "Create user", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"New Employee\",\n  \"username\": \"newemployee\",\n  \"email\": \"newemployee@example.local\",\n  \"password\": \"replace-before-send\",\n  \"roles\": [\"EMPLOYEE\"],\n  \"enabled\": true\n}" }, "url": "{{baseUrl}}/users" } },
        { "name": "Get user", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/users/{{userId}}" } },
        { "name": "Update user", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Updated Employee\",\n  \"username\": \"newemployee\",\n  \"email\": \"newemployee@example.local\",\n  \"roles\": [\"EMPLOYEE\"],\n  \"enabled\": true\n}" }, "url": "{{baseUrl}}/users/{{userId}}" } },
        { "name": "Delete user", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/users/{{userId}}" } }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        { "name": "List scoped tasks", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/tasks?page=0&size=10" } },
        { "name": "Create task", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Example task\",\n  \"description\": \"Replace before sending\",\n  \"priority\": \"MEDIUM\",\n  \"assigneeId\": 1,\n  \"deadline\": \"2026-12-31\"\n}" }, "url": "{{baseUrl}}/tasks" } },
        { "name": "Get task", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/tasks/{{taskId}}" } },
        { "name": "Update task metadata", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Updated example task\",\n  \"description\": \"Replace before sending\",\n  \"priority\": \"HIGH\",\n  \"assigneeId\": 1,\n  \"deadline\": \"2026-12-31\"\n}" }, "url": "{{baseUrl}}/tasks/{{taskId}}" } },
        { "name": "Update task status", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"status\": \"IN_PROGRESS\" }" }, "url": "{{baseUrl}}/tasks/{{taskId}}/status" } },
        { "name": "Delete task", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/tasks/{{taskId}}" } }
      ]
    },
    { "name": "Dashboard stats", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/dashboard/stats" } },
    { "name": "Download task PDF", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/reports/tasks/pdf" } }
  ]
}
